# Backend API - En Railway usamos la URL que da el deploy
VITE_API_URL=https://api.midominio.com/api/v1
# O en Railway:
# VITE_API_URL=https://fip-backend.up.railway.app/api/v1

# App
VITE_APP_NAME=fip
VITE_APP_URL=https://app.tudominio.com
VITE_APP_DESCRIPTION="Financial Intelligence Platform - Gestion financiera personal inteligente"

# Sentry (crear proyecto en sentry.io y obtener DSN)
VITE_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@sentry.io/xxxxxx
VITE_SENTRY_ENVIRONMENT=production

# Segment/PostHog si usamos analytics de usuarios
# VITE_ANALYTICS_KEY=

# Feature flags
VITE_ENABLE_MOCK=false
VITE_ENABLE_DEBUG=false